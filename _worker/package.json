{
  "name": "jackychen-potluck",
  "private": true,
  "type": "module",
  "description": "Potluck sign-up API for jackychen.xyz/events (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply potluck --local",
    "migrate:remote": "wrangler d1 migrations apply potluck --remote",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.2"
  }
}
